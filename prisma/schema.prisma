// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma" // Ensure this path is correct for your project structure
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resume {
  id              String           @id @default(cuid())
  userId          String // Assuming a user ID field for linking to a user (e.g., Clerk ID)

  title           String
  description     String

  photoUrl        String?
  colorHex        String           @default("#000000")
  borderStyle     String           @default("squircle")

  summary         String?
  firstName       String?
  lastName        String?

  jobTitle        String?
  city            String?
  country         String?
  phone           String?
  email           String?

  workExperiences WorkExperience[] // Relation to WorkExperience model
  educations      Education[]      // Relation to Education model

  skills          String[]         // Assuming this is an array of strings for skills

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("resumes") // Maps the Prisma model name "Resume" to the database table name "resumes"
}

model WorkExperience {
  id          String    @id @default(cuid())

  position    String?
  company     String?
  startDate   String?
  endDate     String?
  description String?

  resumeID    String // Foreign key to the Resume model
  resume      Resume    @relation(fields:[resumeID], references: [id], onDelete: Cascade) // onDelete: Cascade ensures related WorkExperiences are deleted when a Resume is deleted

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("work_experience") // Maps to the database table name "work_experience"
}

model Education {
  id          String    @id @default(cuid())

  degree      String?
  school      String?
  startDate   DateTime? // Changed to DateTime? as you have it in Resume model
  endDate     DateTime? // Changed to DateTime? as you have it in Resume model

  resumeID    String // Foreign key to the Resume model
  resume      Resume    @relation(fields:[resumeID], references: [id], onDelete: Cascade) // <--- CRUCIAL FIX: Added onDelete: Cascade

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("educations") // Maps to the database table name "educations"
}
